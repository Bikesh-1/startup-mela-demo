generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                      String              @id @default(cuid())
  email                   String              @unique
  password                String?
  coustumerId             String              @unique
  userdetails             Userdetails?
  sentRequest             Friend[]            @relation("sender")
  receivedRequests        Friend[]            @relation("receiver")
  groupAdmin              Group[]             @relation("GroupCreator")
  groupmembers            Groupmember[]
  contribution            Contribution[]
  verificationTokens      VerificationToken[]
  approvals               RequestApproval[]
  sentrequest             Sentrequest[]
  message                 Message[]
  payoutAccount           PayoutAccount?
  sentTransactions        Transaction[]       @relation("TransactionSender")
  receivedTransactions    Transaction[]       @relation("TransactionReceiver")
  isVerfied               Boolean             @default(false)
  isCompleteProfile       Boolean             @default(false)
  createdAt               DateTime            @default(now())
  updatedAt               DateTime            @default(now())
}

model VerificationToken {
  id                      String      @id @default(cuid())
  token                   String      @unique
  expiresAt               DateTime
  userId                  String
  user                    User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt               DateTime @default(now())

  @@index([userId])
}

model Userdetails {
  id                 String   @id @default(cuid())
  user_id            String   @unique
  user               User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  name               String
  mobileNumber       String
  isprofileCompleted Boolean  @default(false)
  profilephoto       String?
  dateOfbirth        String
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model Friend {
  id         String @id @default(cuid())
  senderId   String
  receiverId String
  sender     User   @relation("sender", fields: [senderId], references: [id], onDelete: Cascade)
  receiver   User   @relation("receiver", fields: [receiverId], references: [id], onDelete: Cascade)

  @@unique([senderId, receiverId])
}

model Group {
  id                  String         @id @default(cuid())
  groupName           String
  groupCode           String         @unique
  description         String
  monthlyContribution Int
  dueDate             String
  groupmember         Groupmember[]
  contribution        Contribution[]
  transactions        Transaction[]
  message             Message[]
  sentrequest         Sentrequest[]
  totalAmount         Int
  createdId           String
  createdBy           User           @relation("GroupCreator", fields: [createdId], references: [id], onDelete: Cascade)
  createdAt           DateTime       @default(now())
}

model Groupmember {
  id       String   @id @default(cuid())
  userId   String
  groupId  String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  group    Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  joinedAt DateTime @default(now())

  @@unique([userId, groupId])
}

model Contribution {
  id        String       @id @default(cuid())
  userId    String
  requestId String?
  groupId   String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  group     Group        @relation(fields: [groupId], references: [id], onDelete: Cascade)
  request   Sentrequest? @relation(fields: [requestId], references: [id])
  amount    Int
  month     String
  status    status       @default(PENDING)
  paidAt    DateTime?
}

model Sentrequest {
  id            String            @id @default(cuid())
  userId        String
  groupId       String
  user          User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  group         Group             @relation(fields: [groupId], references: [id], onDelete: Cascade)
  reason        String
  amount        String
  month         String
  contributions Contribution[]
  approvals     RequestApproval[]
  transactions Transaction[]
  status        RequestStatus     @default(PENDING)
  requestAt     DateTime          @default(now())
  actionAt      DateTime?
}

model Message {
  id        String   @id @default(cuid())
  userId    String
  groupId   String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  group     Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  message   String
  createdAt DateTime @default(now())
  updateAt  DateTime @updatedAt
}

model RequestApproval {
  id            String        @id           @default(cuid())
  requestId     String
  userId        String
  status        ApprovalStatus              @default(PENDING)
  createdAt     DateTime                    @default(now())
  actionAt      DateTime?

  request Sentrequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  user    User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([requestId, userId])
}

model Transaction {
  id        String            @id @default(cuid())

  groupId   String?
  senderId  String?
  receiverId String?

  amount    Int

  type      TransactionType
  status    TransactionStatus @default(PENDING)

  requestId String?
  provider  String?
  providerReference String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  group     Group?      @relation(fields: [groupId], references: [id], onDelete: Cascade)
  sender    User?       @relation("TransactionSender", fields: [senderId], references: [id], onDelete: Cascade)
  receiver  User?       @relation("TransactionReceiver", fields: [receiverId], references: [id], onDelete: Cascade)
  request   Sentrequest? @relation(fields: [requestId], references: [id], onDelete: SetNull)

  @@index([groupId])
  @@index([senderId])
  @@index([receiverId])
  @@index([requestId])
}
model PayoutAccount {
  id                String       @id @default(cuid())

  userId            String       @unique

  type              PayoutType
  upiId             String?
  accountHolderName String?
  accountNumber     String?
  ifsc              String?
  isVerified        Boolean      @default(false)
  isActive          Boolean      @default(true)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  user              User         @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum PayoutType {
  UPI
  BANK
}

enum TransactionType {
  CONTRIBUTION
  PAYOUT
  REFUND
}
enum TransactionStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum status {
  PENDING
  PAID
  OVERDUE
}

enum RequestStatus {
  PENDING
  ACCEPTED
  REJECTED
}
